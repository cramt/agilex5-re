set_global_assignment -name FAMILY "Agilex 5"
set_global_assignment -name DEVICE A5EB013BB23BE4SCS
set_global_assignment -name TOP_LEVEL_ENTITY ct
set_global_assignment -name VERILOG_FILE ct.v
set_global_assignment -name SDC_FILE ct.sdc
set_global_assignment -name DEVICE_INITIALIZATION_CLOCK OSC_CLK_1_125MHZ
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name PWRMGT_VOLTAGE_OUTPUT_FORMAT "LINEAR FORMAT"
set_global_assignment -name PWRMGT_LINEAR_FORMAT_N "-12"
set_global_assignment -name NUM_PARALLEL_PROCESSORS 2

# HVIO bank 6C/6D (hvio_3_1) GPIO0 pins, plus CLOCK2_50 for the second domain.
set_location_assignment PIN_V16 -to CLOCK1_50
set_location_assignment PIN_BF23 -to CLOCK2_50
set_location_assignment PIN_H16 -to CEA
set_location_assignment PIN_Y1 -to CEB
set_location_assignment PIN_C2 -to SCLR
set_location_assignment PIN_P1 -to ACLR
set_location_assignment PIN_Y2 -to ACLRN
set_location_assignment PIN_U2 -to CIN
set_location_assignment PIN_L1 -to DIN
set_location_assignment PIN_F2 -to O[0]
set_location_assignment PIN_P2 -to O[1]
set_location_assignment PIN_B3 -to O[2]
set_location_assignment PIN_H4 -to O[3]
set_location_assignment PIN_H14 -to O[4]
set_location_assignment PIN_C6 -to O[5]
set_location_assignment PIN_H6 -to O[6]
set_location_assignment PIN_B5 -to O[7]
set_location_assignment PIN_H11 -to DOUT
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to *
set_instance_assignment -name FAST_INPUT_REGISTER ON -to DIN
set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to DOUT
