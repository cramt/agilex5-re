set_instance_assignment -name FAST_INPUT_REGISTER ON -to DA
set_instance_assignment -name FAST_INPUT_REGISTER ON -to DB
set_instance_assignment -name FAST_INPUT_REGISTER ON -to DC
set_instance_assignment -name FAST_INPUT_REGISTER ON -to DD
