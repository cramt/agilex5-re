set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to QB
set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to QC
set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to QD
set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to QE
set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to QF
set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to L[0]
