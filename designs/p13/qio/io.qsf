# Quartus' oracle for designs/p10/io (board fixes, 2026-11-06): the same RTL and pins,
# every port in its I/O register as a5pnr places it (pins.txt column reg).
set_global_assignment -name FAMILY "Agilex 5"
set_global_assignment -name DEVICE A5EB013BB23BE4SCS
set_global_assignment -name TOP_LEVEL_ENTITY io
set_global_assignment -name VERILOG_FILE io.v
set_global_assignment -name SDC_FILE io.sdc
set_global_assignment -name DEVICE_INITIALIZATION_CLOCK OSC_CLK_1_125MHZ
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name PWRMGT_VOLTAGE_OUTPUT_FORMAT "LINEAR FORMAT"
set_global_assignment -name PWRMGT_LINEAR_FORMAT_N "-12"
set_global_assignment -name NUM_PARALLEL_PROCESSORS 2
set_location_assignment PIN_V16 -to CLOCK1_50
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to CLOCK1_50
set_location_assignment PIN_C8 -to KEY0
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to KEY0
set_instance_assignment -name FAST_INPUT_REGISTER ON -to KEY0
set_location_assignment PIN_C11 -to KEY1
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to KEY1
set_instance_assignment -name FAST_INPUT_REGISTER ON -to KEY1
set_location_assignment PIN_DK24 -to SW[0]
set_instance_assignment -name IO_STANDARD "1.1-V" -to SW[0]
set_instance_assignment -name FAST_INPUT_REGISTER ON -to SW[0]
set_location_assignment PIN_DD24 -to SW[1]
set_instance_assignment -name IO_STANDARD "1.1-V" -to SW[1]
set_instance_assignment -name FAST_INPUT_REGISTER ON -to SW[1]
set_location_assignment PIN_DD27 -to SW[2]
set_instance_assignment -name IO_STANDARD "1.1-V" -to SW[2]
set_instance_assignment -name FAST_INPUT_REGISTER ON -to SW[2]
set_location_assignment PIN_DF27 -to SW[3]
set_instance_assignment -name IO_STANDARD "1.1-V" -to SW[3]
set_instance_assignment -name FAST_INPUT_REGISTER ON -to SW[3]
set_location_assignment PIN_H16 -to GA
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to GA
set_instance_assignment -name FAST_INPUT_REGISTER ON -to GA
set_location_assignment PIN_Y1 -to GB
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to GB
set_instance_assignment -name FAST_INPUT_REGISTER ON -to GB
set_location_assignment PIN_DF35 -to LED[0]
set_instance_assignment -name IO_STANDARD "1.1-V" -to LED[0]
set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to LED[0]
set_location_assignment PIN_DJ32 -to LED[1]
set_instance_assignment -name IO_STANDARD "1.1-V" -to LED[1]
set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to LED[1]
set_location_assignment PIN_DN22 -to LED[2]
set_instance_assignment -name IO_STANDARD "1.1-V" -to LED[2]
set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to LED[2]
set_location_assignment PIN_DP23 -to LED[3]
set_instance_assignment -name IO_STANDARD "1.1-V" -to LED[3]
set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to LED[3]
set_location_assignment PIN_DN25 -to LED[4]
set_instance_assignment -name IO_STANDARD "1.1-V" -to LED[4]
set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to LED[4]
set_location_assignment PIN_DP25 -to LED[5]
set_instance_assignment -name IO_STANDARD "1.1-V" -to LED[5]
set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to LED[5]
set_location_assignment PIN_DJ27 -to LED[6]
set_instance_assignment -name IO_STANDARD "1.1-V" -to LED[6]
set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to LED[6]
set_location_assignment PIN_DP30 -to LED[7]
set_instance_assignment -name IO_STANDARD "1.1-V" -to LED[7]
set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to LED[7]
set_location_assignment PIN_C2 -to GQ
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to GQ
set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to GQ
set_location_assignment PIN_P1 -to GZ
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to GZ
set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to GZ
set_instance_assignment -name FAST_OUTPUT_ENABLE_REGISTER ON -to GZ
set_global_assignment -name ALLOW_REGISTER_RETIMING OFF
