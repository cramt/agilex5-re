set_global_assignment -name FAMILY "Agilex 5"
set_global_assignment -name DEVICE A5EB013BB23BE4SCS
set_global_assignment -name TOP_LEVEL_ENTITY rt
set_global_assignment -name VERILOG_FILE rt.v
set_global_assignment -name SDC_FILE rt.sdc
set_global_assignment -name DEVICE_INITIALIZATION_CLOCK OSC_CLK_1_125MHZ
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name PWRMGT_VOLTAGE_OUTPUT_FORMAT "LINEAR FORMAT"
set_global_assignment -name PWRMGT_LINEAR_FORMAT_N "-12"
set_global_assignment -name NUM_PARALLEL_PROCESSORS 2

# Only 3.3 V HVIO pins, as in fz.
set_location_assignment PIN_V16 -to CLOCK1_50
set_location_assignment PIN_C8 -to KEY0
set_location_assignment PIN_C19 -to OUT[0]
set_location_assignment PIN_R19 -to OUT[1]
set_location_assignment PIN_B17 -to OUT[2]
set_location_assignment PIN_H19 -to OUT[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to CLOCK1_50
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to KEY0
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to OUT[*]

# Opposite corners: a near X10 Y8 (sector 0), b near X110 Y45 (sector 1).
set_instance_assignment -name PLACE_REGION "X8 Y6 X14 Y10" -to a
set_instance_assignment -name RESERVE_PLACE_REGION OFF -to a
set_instance_assignment -name CORE_ONLY_PLACE_REGION ON -to a
set_instance_assignment -name PLACE_REGION "X104 Y42 X114 Y48" -to b
set_instance_assignment -name RESERVE_PLACE_REGION OFF -to b
set_instance_assignment -name CORE_ONLY_PLACE_REGION ON -to b
